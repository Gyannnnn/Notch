# Neon POOLED connection string (PgBouncer-based) — NOT the direct connection string.
# Required to avoid exhausting Postgres's connection limit under Vercel's serverless model (TRD §9).
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&connection_limit=5&pool_timeout=10"

# Port the Express server listens on locally (Vercel ignores this in serverless deployment).
PORT=3001

# Clerk secret key, used server-side to verify Clerk-issued JWTs on every request.
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare R2 (S3-compatible) access key ID, for generating signed upload URLs.
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare R2 secret access key, paired with R2_ACCESS_KEY_ID.
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare R2 bucket name used for progress photo storage.
R2_BUCKET_NAME="bigbiceps-progress-photos"

# Gemini API key for the optional photo-assist food identification vision call (server-side only).
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# Shared secret used to verify incoming RevenueCat webhook requests are authentic.
REVENUECAT_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
